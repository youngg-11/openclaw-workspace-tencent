# OTP Watcher secrets template
# 请复制为 .env 并填入真实值；不要把 .env 提交到仓库

# Push channel
PUSH_CHANNEL=feishu
PUSH_TARGET=user:your_open_id

# Mailbox 1 (example: Gmail)
MAILBOX_1_TYPE=gmail
MAILBOX_1_HOST=imap.gmail.com
MAILBOX_1_PORT=993
MAILBOX_1_USER=your_email@gmail.com
MAILBOX_1_PASS=app_password_here

# Mailbox 2 (example: Outlook)
MAILBOX_2_TYPE=outlook
MAILBOX_2_HOST=outlook.office365.com
MAILBOX_2_PORT=993
MAILBOX_2_USER=your_email@outlook.com
MAILBOX_2_PASS=app_password_here

# Mailbox 3 (example: QQ)
MAILBOX_3_TYPE=qq
MAILBOX_3_HOST=imap.qq.com
MAILBOX_3_PORT=993
MAILBOX_3_USER=your_email@qq.com
MAILBOX_3_PASS=app_password_here

# Mailbox 4 (example: 126)
MAILBOX_4_TYPE=126
MAILBOX_4_HOST=imap.126.com
MAILBOX_4_PORT=993
MAILBOX_4_USER=your_email@126.com
MAILBOX_4_PASS=app_password_here

# OTP extraction
OTP_REGEX=\\b\\d{4,8}\\b
OTP_KEYWORDS=code,verification,验证码,动态码,校验码,one-time,password

